# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead.

# Connection string from Neon (or any Postgres host). Use verified TLS for remote TCP connections; Neon also supports secure WebSockets.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Default: standard PostgreSQL over TCP. For Neon on networks that block port
# 5432, use websocket to connect securely on port 443 (requires Node.js 22+).
DATABASE_TRANSPORT=tcp

# Long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Port the app listens on (Render sets this automatically, ignore in production)
PORT=3000

# Admin account created explicitly with npm run seed-admin.
# Choose a private password of 12+ characters (at most 72 UTF-8 bytes). Existing accounts are never reset by this command.
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=admin@yourcompany.com
INITIAL_ADMIN_PASSWORD=

# Phase 3: use a DIFFERENT random JWT_SECRET and database role for each environment.
# Production also requires NODE_ENV=production and DEPLOYMENT_ENV=production.
# Exact public origin (no trailing slash); HTTPS required in production.
APP_ORIGIN=http://localhost:3000
# Optional additional exact, trusted frontend origins, comma-separated.
TRUSTED_ORIGINS=
# Set to 1 ONLY behind one trusted proxy that blocks direct backend access.
TRUST_PROXY=0
DEPLOYMENT_ENV=development

# Required for invitations/password recovery. Values belong in private settings.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Cloud environment only, when needed: NODE_USE_ENV_PROXY=1
# This flag configures Node fetch/WebSocket; it does not proxy SMTP TCP.
