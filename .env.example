# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead.

# Connection string from Neon (or any Postgres host). Must include ?sslmode=require for Neon.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Port the app listens on (Render sets this automatically, ignore in production)
PORT=3000

# First admin account, created automatically the first time the server starts
# if no admin exists yet. Change the password immediately after first login.
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=admin@yourcompany.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!
